# Copia este archivo como .env y ajusta los valores. El .env NO se sube a GitHub.

APP_NAME="BEIM Track IA"
APP_TIMEZONE=America/Bogota
# true solo durante el desarrollo: muestra el detalle técnico de los errores
APP_DEBUG=false

# Base de datos (valores por defecto de XAMPP)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=beimtrack_ia
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------
# Avisos por correo electrónico. Están DESACTIVADOS hasta que se
# configure una cuenta SMTP real. Mientras estén desactivados, cada
# evento queda registrado como "omitido" en Administración > Actividad.
# Para Gmail: activa la verificación en dos pasos y crea una
# "contraseña de aplicación" en myaccount.google.com/apppasswords
# ---------------------------------------------------------------

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = SSL
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="BEIM Track"

# ---------------------------------------------------------------
# Asistente Beimy con inteligencia artificial (Google Gemini).
# Sin clave, el chatbot funciona solo con el menú.
# 1. Entra a https://aistudio.google.com/apikey y crea una clave gratis.
# 2. Pégala en GEMINI_API_KEY.
# Si en Windows/XAMPP sale "SSL certificate problem", descarga
# https://curl.se/ca/cacert.pem y pon su ruta en GEMINI_CA_BUNDLE.
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_CA_BUNDLE=
